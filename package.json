{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "markdown-preview",
  "title": "Markdown Preview",
  "description": "A simple way to preview markdown content",
  "icon": "md-preview-icon.png",
  "author": "almatkai",
  "license": "MIT",
  "categories": [
    "Productivity",
    "Web",
    "Developer Tools",
    "Documentation"
  ],
  "commands": [
    {
      "name": "preview-markdown",
      "title": "Preview Markdown",
      "description": "Write and preview Markdown content with real-time rendering",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2",
    "marked": "^14.1.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.markdown-preview",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/markdown-preview",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/markdown-preview",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
