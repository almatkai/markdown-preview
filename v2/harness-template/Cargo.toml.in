[package]
name = "markdown-preview-beta-contract"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
license = "Apache-2.0 AND MIT"
[lib]
test = false
doctest = false
[dependencies]
tezbar-native-markdown-preview = { path = "native-extensions/markdown-preview" }
serde_json = "=1.0.145"
serde = { version = "=1.0.228", features = ["derive"] }
tokio = { version = "=1.43.0", features = ["rt-multi-thread", "macros", "sync", "time"] }
tempfile = "=3.20.0"
uuid = { version = "=1.16.0", features = ["v4"] }
log = "=0.4.27"
